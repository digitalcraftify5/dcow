# Digital Craftify - High-Performance Enterprise Apache Server Configuration

# 1. Force UTF-8 Charset Encoding
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set Content-Type "text/html; charset=UTF-8"
</IfModule>

# 2. Canonical & Domain Normalization (Force 301 HTTPS & www)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://www.digitalcraftify.com/$1 [R=301,L]

  # Force www.digitalcraftify.com
  RewriteCond %{HTTP_HOST} ^digitalcraftify\.com$ [NC]
  RewriteRule ^(.*)$ https://www.digitalcraftify.com/$1 [R=301,L]
</IfModule>

# 3. Enable GZIP & Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. Leverage Browser Caching for Assets & Images
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
