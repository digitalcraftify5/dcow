# Hostinger Apache / LiteSpeed Configuration for Digital Craftify Next.js Static Export
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Serve existing physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Rewrite extensionless URLs to HTML files (e.g., /services -> /services.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Rewrite directory index requests (e.g., /about/ -> /about/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4. Custom 404 Error Document
  ErrorDocument 404 /404.html
</IfModule>

# Security Headers (Safe module guard)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent directory index listings
Options -Indexes
